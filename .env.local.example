# Vercel KV — copy from your KV database dashboard
# https://vercel.com/dashboard → Storage → your KV store → .env.local
KV_REST_API_URL=https://your-kv-store.kv.vercel-storage.com
KV_REST_API_TOKEN=your_token_here

# Optional: set this if you want a read-only token for public endpoints
# KV_REST_API_READ_ONLY_TOKEN=your_read_only_token_here
